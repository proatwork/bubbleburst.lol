# Google Analytics 4 measurement ID. Leave empty to build without GA (the tag is omitted entirely).
PUBLIC_GA_MEASUREMENT_ID=

# PostHog project API key (phc_...). Leave empty to build without PostHog (the snippet is omitted entirely).
PUBLIC_POSTHOG_KEY=

# PostHog ingestion host. Defaults to PostHog Cloud EU (https://eu.i.posthog.com); set https://us.i.posthog.com for a US project.
PUBLIC_POSTHOG_HOST=

# Canonical site URL, no trailing slash. Used for <link rel="canonical">, Open Graph and JSON-LD.
PUBLIC_SITE_URL=
 