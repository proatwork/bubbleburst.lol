---
import type { Signal } from '../lib/schema.ts';
import { renderCitationLinks, renderText } from '../lib/cite.ts';
import { TREND_ARROWS } from '../lib/trend.ts';
import Explain from './Explain.astro';

interface Props {
  signals: Signal[];
  sourceCount: number;
  /** Optional section heading; the key-signals strip under the hero has none. */
  heading?: string;
  /** One line under the heading, e.g. what these tiles are and are not. */
  caption?: string;
  /** 'scored' (default) is the filled strip; 'unscored' is outlined, for tiles the score ignores on purpose. */
  tone?: 'scored' | 'unscored';
  ariaLabel?: string;
}

const { signals, sourceCount, heading, caption, tone = 'scored', ariaLabel = 'Key signals' } = Astro.props;
const slug = heading ? heading.toLowerCase().replace(/[^a-z0-9]+/g, '-') : 'signals';
const headingId = heading ? `${slug}-heading` : undefined;
---
<section class="signals" data-tone={tone} aria-label={heading ? undefined : ariaLabel} aria-labelledby={headingId}>
  {heading && (
    <div class="head">
      <h2 id={headingId}>{heading}</h2>
      {caption && <p class="caption">{caption}</p>}
    </div>
  )}
  <ul class="strip" data-count={signals.length}>
    {signals.map((signal, i) => (
      <li class="tile">
        <span class="label">
          {signal.eli5 ? <Explain id={`explain-${slug}-${i + 1}`} text={signal.eli5}>{signal.label}</Explain> : signal.label}
        </span>
        <span class="value">
          {signal.value}
          {signal.trend && (
            <span class="trend" data-trend={signal.trend}>
              <svg viewBox="0 0 12 14" width="12" height="14" aria-hidden="true" focusable="false">
                <path d={TREND_ARROWS[signal.trend].d} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="visually-hidden">{TREND_ARROWS[signal.trend].word}</span>
            </span>
          )}
        </span>
        <span class="note" set:html={`${renderText(signal.note)}${renderCitationLinks(signal.sources, sourceCount)}`} />
      </li>
    ))}
  </ul>
</section>

<style>
  .signals {
    display: grid;
    gap: var(--space-md);
  }

  .head {
    display: grid;
    gap: var(--space-2xs);
  }

  .caption {
    max-width: 60ch;
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .strip {
    list-style: none;
    margin: 0;
    padding: var(--space-xs) var(--space-lg);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--color-paper-2);
    border-radius: var(--radius-lg);
  }

  .signals[data-tone='unscored'] .strip {
    background: transparent;
    border: var(--rule) dashed var(--color-rule-2);
  }

  .tile {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-md) var(--space-md) var(--space-md) 0;
    min-width: 0;
  }

  .tile:nth-child(even) {
    border-inline-start: var(--rule) solid var(--color-rule);
    padding-inline-start: var(--space-md);
  }

  .tile:nth-child(n + 3) {
    border-top: var(--rule) solid var(--color-rule);
  }

  .value {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
    font-variant-numeric: lining-nums;
    color: var(--color-ink);
  }

  .trend {
    display: inline-flex;
    color: var(--color-muted);
    transform: translateY(1px);
  }

  .note {
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  @media (min-width: 60rem) {
    .strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* Fewer tiles than columns: let each take a column, left-aligned, without stretching the last. */
    .strip[data-count='1'] {
      grid-template-columns: minmax(0, 1fr) repeat(3, minmax(0, 1fr));
    }

    .tile:nth-child(n + 3) {
      border-top: 0;
    }

    .tile:nth-child(even) {
      border-inline-start: 0;
      padding-inline-start: 0;
    }

    .tile + .tile {
      border-inline-start: var(--rule) solid var(--color-rule);
      padding-inline-start: var(--space-lg);
    }
  }
</style>
