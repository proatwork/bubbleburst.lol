---
import { SITE } from '../config.ts';
import { formatTimestamp } from '../lib/format.ts';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  updatedAt: string;
}

const { updatedAt } = Astro.props;
---
<header class="nav-edge page">
  <div class="brand">
    <a class="wordmark" href="/">{SITE.name}</a>
    <span class="label stamp">AI bubble status · <time datetime={updatedAt} data-local="short">{formatTimestamp(updatedAt)}</time></span>
  </div>
  <ThemeToggle />
</header>

<style>
  .nav-edge {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-bottom: var(--rule) solid var(--color-rule);
  }

  .brand {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-md);
    min-width: 0;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .stamp {
    white-space: nowrap;
  }

  @media (max-width: 26rem) {
    .stamp {
      display: none;
    }
  }
</style>
