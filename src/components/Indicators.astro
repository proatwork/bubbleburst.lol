---
import type { Indicator, Source } from '../lib/schema.ts';
import { renderCitationLinks, renderText } from '../lib/cite.ts';
import { formatShortDate, formatSigned } from '../lib/format.ts';
import type { IndicatorPoint } from '../lib/history.ts';
import { GROUP_LABEL, bandForScore, formatReading, formatScore, isSaturated } from '../lib/indicators.ts';
import { TREND_ARROWS } from '../lib/trend.ts';

interface Props {
  indicators: Indicator[];
  sources: Source[];
  sourceCount: number;
  /** Per-indicator score history from the archive, for the sparklines. */
  history: Map<string, IndicatorPoint[]>;
}

const { indicators, sources, sourceCount, history } = Astro.props;

/** Furthest into bubble territory first, so the first row answers "what is most stretched". */
const rows = [...indicators].sort((a, b) => b.score - a.score || b.weight - a.weight);

const publishers = Array.from(
  new Set(indicators.flatMap((i) => i.sources).map((n) => sources[n - 1]?.publisher).filter((p): p is string => Boolean(p))),
);

const SPARK_W = 72;
const SPARK_H = 20;

function sparkline(points: IndicatorPoint[]): { d: string; last: { x: number; y: number } } | null {
  if (points.length < 2) return null;
  const t0 = points[0].time;
  const t1 = points[points.length - 1].time;
  const span = Math.max(1, t1 - t0);
  const coords = points.map((p) => ({
    x: 1 + ((p.time - t0) / span) * (SPARK_W - 2),
    y: 2 + (1 - Math.min(100, Math.max(0, p.score)) / 100) * (SPARK_H - 4),
  }));
  const d = coords.map((c, i) => `${i === 0 ? 'M' : 'L'}${c.x.toFixed(1)} ${c.y.toFixed(1)}`).join(' ');
  return { d, last: coords[coords.length - 1] };
}

function scoreChange(indicator: Indicator): number | null {
  if (indicator.previousScore === undefined) return null;
  return Math.round(indicator.score - indicator.previousScore);
}
---
<section class="basket" aria-labelledby="basket-heading">
  <div class="head">
    <h2 id="basket-heading">The basket</h2>
    <p class="caption">
      {indicators.length} indicators behind the score. Each is scored 0–100 between a calm level and the level reached before a past burst;
      100 means the reading is at or beyond that level. Sorted from most to least stretched.
    </p>
  </div>

  <ol class="rows">
    <li class="row header" aria-hidden="true">
      <span>Indicator</span>
      <span>Latest reading</span>
      <span>Bubble score</span>
    </li>
    {rows.map((indicator) => {
      const band = bandForScore(indicator.score);
      const saturated = isSaturated(indicator.score);
      const change = scoreChange(indicator);
      const spark = sparkline(history.get(indicator.id) ?? []);
      return (
        <li class="row" id={`indicator-${indicator.id}`} data-band={band.id} data-stale={indicator.stale ? '' : undefined} style={`--score: ${indicator.score}`}>
          <div class="who">
            <span class="name">
              {indicator.label}
              <span class="group">{GROUP_LABEL[indicator.group]}</span>
            </span>
            <span class="detail" set:html={`${renderText(indicator.detail)}${renderCitationLinks(indicator.sources, sourceCount)}`} />
          </div>

          <div class="reading">
            <span class="value">
              <span class="num">{formatReading(indicator.value)}</span>
              <span class="unit">{indicator.unit}</span>
              {indicator.trend && (
                <span class="trend">
                  <svg viewBox="0 0 12 14" width="12" height="14" aria-hidden="true" focusable="false">
                    <path d={TREND_ARROWS[indicator.trend].d} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="visually-hidden">{TREND_ARROWS[indicator.trend].word}</span>
                </span>
              )}
            </span>
            <span class="meta">
              as of {formatShortDate(indicator.asOf)}
              {indicator.direction === 'lower' && <span class="tag" title="A lower reading means more bubble pressure">lower = more</span>}
              {indicator.stale && <span class="tag warn">carried forward</span>}
              {indicator.verified === false && <span class="tag warn">feed unverified</span>}
            </span>
          </div>

          <div class="score">
            <span class="bar" role="img" aria-label={`Bubble score ${formatScore(indicator.score)} of 100, ${band.label}`}>
              <span class="fill"></span>
            </span>
            <span class="score-line">
              <span class="score-num">{formatScore(indicator.score)}</span>
              <span class="score-of">/100</span>
              {change !== null && (
                <span class="change" data-direction={change > 0 ? 'up' : change < 0 ? 'down' : 'flat'}>
                  {formatSigned(change)}
                  <span class="visually-hidden"> since the previous run</span>
                </span>
              )}
              <span class="weight" title="Weight in the weighted mean">×{indicator.weight}</span>
              {spark && (
                <svg class="spark" viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} width={SPARK_W} height={SPARK_H} role="img" aria-label={`Score history, ${history.get(indicator.id)!.length} readings`}>
                  <path d={spark.d} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx={spark.last.x} cy={spark.last.y} r="2" fill="currentColor" />
                </svg>
              )}
            </span>
            {saturated && <span class="saturated">at or beyond a pre-burst level</span>}
          </div>
        </li>
      );
    })}
  </ol>

  {publishers.length > 0 && (
    <p class="credits">Readings via {publishers.join(', ')}. Each links to the page it was read from. Index levels are shown only as ratios.</p>
  )}
</section>

<style>
  .basket {
    display: grid;
    gap: var(--space-md);
  }

  .head {
    display: grid;
    gap: var(--space-2xs);
  }

  .caption,
  .credits {
    max-width: 64ch;
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: var(--rule) solid var(--color-rule);
  }

  .row {
    --status: var(--color-status-calm);
    display: grid;
    gap: var(--space-xs) var(--space-lg);
    padding-block: var(--space-sm);
    border-bottom: var(--rule) solid var(--color-rule);
    scroll-margin-top: var(--space-xl);
  }

  .row[data-band='inflating'] { --status: var(--color-status-inflating); }
  .row[data-band='stretched'] { --status: var(--color-status-stretched); }
  .row[data-band='critical'] { --status: var(--color-status-critical); }

  .row.header {
    display: none;
  }

  .who,
  .reading,
  .score {
    display: grid;
    align-content: start;
    gap: var(--space-3xs);
    min-width: 0;
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-xs);
    font-weight: 500;
    color: var(--color-ink);
  }

  .group {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .detail,
  .meta {
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .value {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--color-ink);
  }

  .num {
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .unit {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .trend {
    display: inline-flex;
    color: var(--color-muted);
    transform: translateY(1px);
  }

  .row[data-stale] .num {
    color: var(--color-muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    padding: 1px var(--space-xs);
    border: var(--rule) solid var(--color-rule-2);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    white-space: nowrap;
  }

  .tag.warn {
    border-style: dashed;
  }

  /* The score: a thin track in the meter's colours, revealed to the score. */
  .bar {
    display: block;
    position: relative;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
    overflow: clip;
  }

  .fill {
    position: absolute;
    inset: 0;
    width: calc(var(--score) * 1%);
    border-radius: inherit;
    background: var(--status);
  }

  .score-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .score-num {
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
    color: var(--color-ink);
  }

  .score-of,
  .weight {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .weight {
    margin-inline-start: auto;
  }

  .change {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
  }

  .change[data-direction='up'] {
    color: var(--color-ink-2);
  }

  .spark {
    color: var(--color-muted);
    align-self: center;
  }

  .saturated {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--status);
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: start;
    }

    .row.header {
      display: grid;
      padding-block: var(--space-xs);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .bar {
      margin-top: 0.45em;
    }
  }
</style>
