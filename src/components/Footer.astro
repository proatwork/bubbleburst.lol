---
import { SITE } from '../config.ts';
import { formatTimestamp } from '../lib/format.ts';

interface Props {
  updatedAt: string;
  generatedBy: string;
  consentUi: boolean;
}

const { updatedAt, generatedBy, consentUi } = Astro.props;
---
<footer class="foot-line page">
  <p>
    <span>Written by {SITE.author} ({generatedBy}) from the sources above</span>
    <span class="sep" aria-hidden="true">·</span>
    <span>Updated <time datetime={updatedAt} data-local="short">{formatTimestamp(updatedAt)}</time></span>
    <span class="sep" aria-hidden="true">·</span>
    <span>Refreshed several times a day</span>
    <span class="sep" aria-hidden="true">·</span>
    <span>Not financial advice</span>
    {consentUi && (
      <>
        <span class="sep" aria-hidden="true">·</span>
        <button class="btn-link" type="button" data-consent-open>Cookie settings</button>
      </>
    )}
  </p>
</footer>

<style>
  .foot-line {
    padding-block: var(--space-lg) var(--space-xl);
    border-top: var(--rule) solid var(--color-rule);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .foot-line p {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
  }
</style>
