---
/**
 * GA4. Nothing renders unless PUBLIC_GA_MEASUREMENT_ID is set.
 * consentMode 'none': plain tag, tracking on for every visit.
 * 'advanced' / 'basic': Consent Mode v2 with storage denied until the visitor allows it (see ConsentBar).
 */
import { SITE, STORAGE_KEYS } from '../config.ts';

const id = SITE.gaMeasurementId;
const consentKey = STORAGE_KEYS.consent;
const mode = SITE.consentMode;
const loaderSrc = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
---
{id && mode === 'none' && (
  <>
    <script is:inline async src={loaderSrc}></script>
    <script define:vars={{ id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', id);
    </script>
  </>
)}
{id && mode !== 'none' && (
  <>
    <script define:vars={{ id, consentKey, basicMode: mode === 'basic', loaderSrc }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      var loaded = false;
      window.bbLoadAnalytics = function () {
        if (loaded) return;
        loaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = loaderSrc;
        document.head.appendChild(s);
      };
      var granted = false;
      try {
        granted = localStorage.getItem(consentKey) === 'granted';
      } catch (error) {
        /* storage blocked: stay on the denied default */
      }
      if (granted) gtag('consent', 'update', { analytics_storage: 'granted' });
      gtag('js', new Date());
      gtag('config', id);
      if (!basicMode || granted) window.bbLoadAnalytics();
    </script>
  </>
)}
