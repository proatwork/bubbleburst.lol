---
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';

import raw from '../../content/status.json';
import { SITE, STORAGE_KEYS } from '../config.ts';
import { bandFor, deltaFor } from '../lib/bands.ts';
import { renderWithCitations, smarten } from '../lib/cite.ts';
import { formatLongTimestamp } from '../lib/format.ts';
import { buildSeries, indicatorHistory } from '../lib/history.ts';
import { parseStatus } from '../lib/status.ts';
import Header from '../components/Header.astro';
import Meter from '../components/Meter.astro';
import Composite from '../components/Composite.astro';
import Signals from '../components/Signals.astro';
import Indicators from '../components/Indicators.astro';
import History from '../components/History.astro';
import Analysis from '../components/Analysis.astro';
import Sources from '../components/Sources.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBar from '../components/ConsentBar.astro';

// Build fails here if content/status.json is invalid. That is the point.
const status = parseStatus(raw);
const band = bandFor(status.pressure);
const delta = deltaFor(status.pressure, status.previousPressure);
const sourceCount = status.sources.length;

// The history view is the archive plus the live file. A malformed archive file is skipped, never fatal.
const archive = import.meta.glob('../../content/history/*.json', { eager: true, import: 'default' }) as Record<string, unknown>;
const series = buildSeries({ ...archive, 'content/status.json': raw });
for (const file of series.rejected) console.warn(`history: skipped ${file.name} (${file.reason})`);
const scoreHistory = indicatorHistory(series.points);

const headline = smarten(status.headline);
const description = smarten(status.summary).replace(/\s*\[\d+\]/g, '');
const title = `${SITE.question} ${status.pressure}/100, ${band.label} · ${SITE.name}`;
const canonical = SITE.url ? `${SITE.url}/` : undefined;
const analyticsEnabled = Boolean(SITE.gaMeasurementId);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  headline,
  description,
  ...(canonical ? { url: canonical } : {}),
  dateModified: status.updatedAt,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: SITE.name, ...(canonical ? { url: canonical } : {}) },
  citation: status.sources.map((source) => ({
    '@type': 'CreativeWork',
    name: source.title,
    url: source.url,
    publisher: { '@type': 'Organization', name: source.publisher },
    datePublished: source.date,
  })),
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const themeKey = STORAGE_KEYS.theme;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f3ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#130e0a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={jsonLdText} />
    <script define:vars={{ themeKey }}>
      document.documentElement.dataset.js = '';
      try {
        var theme = localStorage.getItem(themeKey);
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch (error) {
        /* storage blocked: stay on automatic */
      }
    </script>
    <Analytics />
  </head>
  <body>
    <Header updatedAt={status.updatedAt} />
    <main class="page">
      <section class="hero" aria-labelledby="headline">
        <Meter pressure={status.pressure} band={band} delta={delta} />
        <div class="lede">
          <p class="label dateline">Status as of <time datetime={status.updatedAt} data-local="long">{formatLongTimestamp(status.updatedAt)}</time></p>
          <h1 id="headline" class:list={{ 'is-long': headline.length > 50 }}>{headline}</h1>
          <p class="summary" set:html={renderWithCitations(status.summary, sourceCount)} />
        </div>
      </section>
      {status.indicators && status.composite && (
        <Composite composite={status.composite} indicators={status.indicators} pressure={status.pressure} />
      )}
      <Signals signals={status.signals} sourceCount={sourceCount} />
      {status.indicators && (
        <div class="block">
          <Indicators indicators={status.indicators} sources={status.sources} sourceCount={sourceCount} history={scoreHistory} />
        </div>
      )}
      {status.fundamentals && (
        <div class="block">
          <Signals
            signals={status.fundamentals}
            sourceCount={sourceCount}
            heading="Fundamentals check"
            caption="Not in the score, on purpose. These are the readings the bull case rests on; the pressure number ignores them so it cannot quietly average them away."
            tone="unscored"
          />
        </div>
      )}
      {series.points.length > 0 && (
        <div class="block">
          <History points={series.points} />
        </div>
      )}
      <div class="columns">
        <Analysis paragraphs={status.analysis} sourceCount={sourceCount} />
        <Sources sources={status.sources} />
      </div>
    </main>
    <Footer updatedAt={status.updatedAt} generatedBy={status.generatedBy} analyticsEnabled={analyticsEnabled} />
    {analyticsEnabled && SITE.consentBanner && <ConsentBar />}
    <script>
      // Progressive enhancement: the HTML carries UTC; show the visitor's local time instead.
      const LONG: Intl.DateTimeFormatOptions = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' };
      const SHORT: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' };
      for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-local]')) {
        try {
          const date = new Date(el.dateTime);
          if (Number.isNaN(date.getTime())) continue;
          el.textContent = new Intl.DateTimeFormat('en-GB', el.dataset.local === 'long' ? LONG : SHORT).format(date);
          el.title = `${el.textContent} (your local time)`;
        } catch {
          /* leave the UTC text in place */
        }
      }
    </script>
  </body>
</html>

<style>
  .hero {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-lg) var(--space-xl);
  }

  .lede {
    display: grid;
    gap: var(--space-md);
    align-content: center;
    min-width: 0;
  }

  .dateline {
    color: var(--color-muted);
  }

  .summary {
    max-width: 52ch;
    font-size: var(--text-md);
    line-height: 1.45;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  .block {
    padding-block: var(--space-xl) 0;
  }

  .columns {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl) var(--space-xl);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
      align-items: center;
      padding-block: var(--space-lg) var(--space-xl);
    }

    .columns {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-2xl);
      padding-block: var(--space-xl) var(--space-2xl);
    }
  }
</style>
