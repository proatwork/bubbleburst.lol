  "version": "1.0.0",
  "private": true,
  "description": "Daily AI bubble status: one page, one score, sourced analysis.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
